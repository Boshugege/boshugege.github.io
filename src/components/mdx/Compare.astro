---
// Two images compared. Put one Markdown image per line:
// <Compare labels={["之前", "之后"]} caption="说明">
// ![a](./a.jpg)
// ![b](./b.jpg)
// </Compare>
//
// mode="side-by-side" (default): columns, stacked on phones, each label under
// its own image.
// mode="slider": the two images on top of each other with a draggable divider
// (initial={50} sets where it starts, in %). Needs exactly two images of the
// same aspect ratio (within 1%); otherwise, and without JavaScript, it stays
// side by side.
interface Props {
  labels?: string[];
  caption?: string;
  mode?: "side-by-side" | "slider";
  initial?: number;
}
const { labels = [], caption, mode = "side-by-side", initial = 50 } = Astro.props;
const html = await Astro.slots.render("default");
// Quoted attribute values may contain ">" (alt text), so skip over them.
const images = html.match(/<img\b(?:[^>"']|"[^"]*"|'[^']*')*>/g) || [];
const sizes = images.map((image) => ({
  width: Number(/\swidth="(\d+)"/.exec(image)?.[1]) || 0,
  height: Number(/\sheight="(\d+)"/.exec(image)?.[1]) || 0,
}));
const ratios = sizes.map(({ width, height }) => (width && height ? width / height : 0));
const sameShape = ratios.length === 2 && (!ratios[0] || !ratios[1] || Math.abs(ratios[0] / ratios[1] - 1) < 0.01);
const slider = mode === "slider" && images.length === 2 && sameShape;
const start = Number.isFinite(Number(initial)) ? Math.min(100, Math.max(0, Number(initial))) : 50;
// Never wider than the smaller image: a low-resolution render is not stretched.
const widths = sizes.map(({ width }) => width).filter((width) => width > 0);
const displayWidth = slider && widths.length === 2 ? Math.min(...widths) : undefined;
const sliderLabel = labels.length >= 2 ? `拖动对比：${labels[0]} / ${labels[1]}` : "拖动对比两张图";
---
<figure
  class:list={["mdx-compare", { "mdx-compare-slider": slider }]}
  data-compare-slider={slider ? "" : undefined}
  data-initial={slider ? start : undefined}
  style={slider ? `--split: ${start}%;${displayWidth ? ` --compare-width: ${displayWidth}px;` : ""}` : undefined}
>
  {images.length > 0 ? (
    <div class="mdx-compare-grid" data-compare-stage={slider ? "" : undefined}>
      {images.map((image, index) => (
        <figure class="mdx-compare-item">
          <Fragment set:html={image} />
          {labels[index] && <figcaption class="mdx-compare-label">{labels[index]}</figcaption>}
        </figure>
      ))}
      {slider && (
        <div class="mdx-compare-ui" data-compare-ui hidden>
          <span class="mdx-compare-divider" aria-hidden="true"></span>
          <span
            class="mdx-compare-handle"
            role="slider"
            tabindex="0"
            aria-label={sliderLabel}
            aria-orientation="horizontal"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow={Math.round(start)}
            data-compare-handle
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9.5 7.5 5 12l4.5 4.5M14.5 7.5 19 12l-4.5 4.5" /></svg>
          </span>
        </div>
      )}
    </div>
  ) : (
    <div class="mdx-compare-grid mdx-compare-raw" set:html={html} />
  )}
  {caption && <figcaption class="mdx-compare-caption">{caption}</figcaption>}
</figure>
<script>
  // Bundled once per page; does nothing where no slider is rendered.
  import "../../scripts/compare-slider";
</script>
<style>
  .mdx-compare { margin: 20px 0; }
  .mdx-compare-grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 8px;
  }
  .mdx-compare .mdx-compare-item { min-width: 0; margin: 0; }
  .mdx-compare-grid :global(img) { width: 100%; height: auto; margin: 0; border-radius: var(--radius); }
  .mdx-compare-raw :global(p) { display: contents; }
  .mdx-compare-label {
    margin-top: 4px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.45;
    text-align: center;
  }
  .mdx-compare-caption { margin-top: 6px; color: var(--muted); font-size: 14px; text-align: center; }
  .mdx-compare-ui[hidden] { display: none; }
  @media (max-width: 600px) {
    .mdx-compare-grid { grid-auto-flow: row; gap: 14px; }
  }

  /* Slider: set up by src/scripts/compare-slider.ts (class is-ready). Both
     images share one grid cell, so they align pixel for pixel; moving the
     divider only changes --split, which clips the upper image (no reflow). */
  .mdx-compare-slider.is-ready .mdx-compare-grid {
    position: relative;
    grid-template-areas: "stack";
    gap: 0;
    /* + 2px: the 1px border sits inside the width, the image keeps its pixels. */
    width: min(100%, calc(var(--compare-width, 100%) + 2px));
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--code-bg);
    box-shadow: 0 1px 2px rgba(20, 33, 48, 0.06), 0 10px 24px -14px rgba(20, 33, 48, 0.35);
    cursor: ew-resize;
    /* Vertical scrolling and pinch-zoom stay with the browser; sideways
       swipes move the divider. */
    touch-action: pan-y;
    touch-action: pan-y pinch-zoom;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  :global(:root[data-theme="dark"]) .mdx-compare-slider.is-ready .mdx-compare-grid {
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 12px 28px -14px rgba(0, 0, 0, 0.7);
  }
  .mdx-compare-slider.is-ready .mdx-compare-item {
    position: relative;
    grid-area: stack;
  }
  .mdx-compare-slider.is-ready .mdx-compare-item:first-child { z-index: 1; }
  .mdx-compare-slider.is-ready .mdx-compare-grid :global(img) {
    display: block;
    border-radius: 0;
    pointer-events: none;
    -webkit-user-drag: none;
  }
  .mdx-compare-slider.is-ready .mdx-compare-item:first-child :global(img) {
    clip-path: inset(0 calc(100% - var(--split, 50%)) 0 0);
  }
  /* Frosted corner labels; the one the divider is about to cover fades out. */
  .mdx-compare-slider.is-ready .mdx-compare-label {
    position: absolute;
    top: 10px;
    z-index: 3;
    max-width: calc(50% - 20px);
    margin: 0;
    padding: 1px 9px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    background: rgba(16, 22, 28, 0.42);
    color: #f3f6f8;
    font-size: 12px;
    line-height: 1.6;
    white-space: nowrap;
    text-overflow: ellipsis;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    pointer-events: none;
    transition: opacity 180ms ease;
  }
  .mdx-compare-slider.is-ready .mdx-compare-item:first-child .mdx-compare-label { left: 10px; }
  /* The slider UI follows the two items, so the second one is not :last-child. */
  .mdx-compare-slider.is-ready .mdx-compare-item + .mdx-compare-item .mdx-compare-label { right: 10px; }
  .mdx-compare-slider.is-ready .mdx-compare-label.is-faded { opacity: 0; }
  .mdx-compare-ui {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }
  /* A light hairline with a dark halo stays crisp on white and black renders. */
  .mdx-compare-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split, 50%);
    width: 1.5px;
    transform: translateX(-50%);
    background: rgba(240, 248, 255, 0.92);
    box-shadow: 0 0 0 0.5px rgba(10, 16, 22, 0.35), 0 0 8px rgba(10, 16, 22, 0.35);
  }
  .mdx-compare-handle {
    position: absolute;
    top: 50%;
    left: var(--split, 50%);
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 50%;
    background: rgba(20, 33, 48, 0.3);
    color: #fff;
    box-shadow: 0 2px 10px rgba(10, 16, 22, 0.3);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    transform: translate(-50%, -50%);
    cursor: ew-resize;
    pointer-events: auto;
    transition: transform 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
  }
  .mdx-compare-handle svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mdx-compare-slider.is-ready .mdx-compare-grid:hover .mdx-compare-handle,
  .mdx-compare-slider.is-dragging .mdx-compare-handle {
    background: rgba(20, 33, 48, 0.46);
    box-shadow: 0 3px 14px rgba(10, 16, 22, 0.38);
    transform: translate(-50%, -50%) scale(1.06);
  }
  /* White ring with a dark halo: visible on any render, light or dark. */
  .mdx-compare-handle:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
    box-shadow: 0 0 0 5px rgba(10, 16, 22, 0.75), 0 2px 10px rgba(10, 16, 22, 0.3);
  }
  /* Keep the halo while hovered or dragged (that rule sets its own shadow). */
  .mdx-compare-slider.is-ready .mdx-compare-grid:hover .mdx-compare-handle:focus-visible,
  .mdx-compare-slider.is-dragging .mdx-compare-handle:focus-visible {
    box-shadow: 0 0 0 5px rgba(10, 16, 22, 0.75), 0 3px 14px rgba(10, 16, 22, 0.38);
  }
  /* A click or tap jumps there smoothly; dragging follows the pointer directly. */
  .mdx-compare-slider.is-animating .mdx-compare-item:first-child :global(img) { transition: clip-path 200ms ease; }
  .mdx-compare-slider.is-animating .mdx-compare-divider { transition: left 200ms ease; }
  .mdx-compare-slider.is-animating .mdx-compare-handle { transition: left 200ms ease, transform 160ms ease; }
  @media (prefers-reduced-motion: reduce) {
    .mdx-compare-slider.is-ready .mdx-compare-label,
    .mdx-compare-slider .mdx-compare-handle,
    .mdx-compare-slider.is-animating .mdx-compare-divider,
    .mdx-compare-slider.is-animating .mdx-compare-handle,
    .mdx-compare-slider.is-animating .mdx-compare-item:first-child :global(img) { transition: none; }
  }
</style>
