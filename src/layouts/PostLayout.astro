---
import PncLogo from "../components/PncLogo.astro";
import { formatDate, normalizeTags, site } from "../lib/site";
import ThemeToggle from "../components/ThemeToggle.astro";
import Comments from "../components/Comments.astro";
import PostToc from "../components/PostToc.astro";
import ShareButton from "../components/ShareButton.astro";
import DocumentLayout from "./DocumentLayout.astro";
import type { TableOfContents } from "../lib/toc";
import "../styles/content.css";

interface Props {
  title: string;
  description?: string;
  date: Date | string;
  tags?: string[] | string;
  canonicalPath: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  updated?: Date | string;
  contentClass?: string;
  wordCount?: number;
  readingMinutes?: number;
  hasMath?: boolean;
  toc?: TableOfContents;
  previousPost?: { title: string; url: string };
  nextPost?: { title: string; url: string };
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = "",
  date,
  tags = [],
  canonicalPath,
  image = site.defaultCover,
  imageAlt = site.defaultCoverAlt,
  imageWidth,
  imageHeight,
  updated,
  contentClass = "",
  wordCount,
  readingMinutes,
  hasMath = false,
  toc,
  previousPost,
  nextPost,
  jsonLd,
} = Astro.props;

const dateText = formatDate(date);
const updatedText = updated ? formatDate(updated) : undefined;
const tagList = normalizeTags(tags);
const excerpt = description || site.homeDescription;
const statsApi = (import.meta.env.PUBLIC_COMMENTS_API || "/api").replace(/\/$/, "");
const postSlug = Astro.url.pathname;
---

<DocumentLayout
  title={title}
  pageTitle={title}
  description={excerpt}
  canonicalPath={canonicalPath}
  ogType="article"
  image={image}
  imageAlt={imageAlt}
  imageWidth={imageWidth}
  imageHeight={imageHeight}
  includeKatex={hasMath}
  articlePublishedTime={dateText}
  articleModifiedTime={updatedText || dateText}
  jsonLd={jsonLd}
  postMeta={{ title, date: dateText, updated: updatedText, tags: tagList, excerpt, cover: image, coverAlt: imageAlt, url: canonicalPath }}
>
  <article class:list={["post-content", contentClass]}>
    <header class="post-topbar">
      <div class="pnc-brand" transition:name="site-brand">
        <PncLogo size={22} />
        <a class="site-title site-brand post-site-brand" href="/index.html">{site.name}</a>
      </div>
      <nav class="post-topnav" aria-label="站点导航">
        <a href="/about.html">About</a>
        <a href="/notes.html">随想</a>
        <a href={`mailto:${site.email}`}>Email</a>
        <a href="/rss.xml">RSS</a>
        <a href={site.github}>GitHub</a>
      </nav>
      <ThemeToggle />
    </header>
    <h1>{title}</h1>
    <div class="post-meta">
      <p class="meta-facts" data-post-view data-api-base={statsApi} data-post-slug={postSlug}>
        <time datetime={dateText}>{dateText}</time>
        {updatedText && updatedText !== dateText && <span>更新于 {updatedText}</span>}
        {typeof wordCount === "number" && <span>{wordCount.toLocaleString("zh-CN")} 字</span>}
        {typeof readingMinutes === "number" && <span>{readingMinutes} 分钟</span>}
        <span class="view-count" hidden><span data-post-view-count>—</span> 次阅读</span>
      </p>
      <ShareButton title={title} text={excerpt} url={canonicalPath} />
    </div>
    {toc && <PostToc items={toc.items} count={toc.count} variant="inline" />}
    <div class="post-reading-layout">
      <div class="post-body" data-post-body>
        <slot />
        {tagList.length > 0 && (
          <nav class="post-tags" aria-label="标签">
            {tagList.map((tag) => <a href={`/index.html?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}
          </nav>
        )}
        <Comments postSlug={canonicalPath} />
        <nav class="post-nav" aria-label="文章导航">
          {previousPost ? (
            <a class="post-nav-prev" href={previousPost.url}>
              <span class="post-nav-label">← 上一篇</span>
              <span class="post-nav-title">{previousPost.title}</span>
            </a>
          ) : <span />}
          {nextPost && (
            <a class="post-nav-next" href={nextPost.url}>
              <span class="post-nav-label">下一篇 →</span>
              <span class="post-nav-title">{nextPost.title}</span>
            </a>
          )}
        </nav>
      </div>
      {toc && <PostToc items={toc.items} count={toc.count} variant="rail" />}
    </div>
  </article>
  <script>
    import "../scripts/code-copy";
    import "../scripts/post-toc";
    import "../scripts/site-stats";
  </script>
</DocumentLayout>
