---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getNotes } from "../lib/notes";
import { getAllPosts, toPlainText } from "../lib/content/posts";
import { absoluteUrl, site } from "../lib/site";

const posts = await getAllPosts();
const notes = await getNotes();
const latestNote = notes[0];
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.tags) tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const statsApi = (import.meta.env.PUBLIC_COMMENTS_API || "/api").replace(/\/$/, "");
---

<BaseLayout
  title={site.name}
  canonicalPath="/index.html"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: site.url,
    potentialAction: {
      "@type": "SearchAction",
      target: `${site.url}/index.html?q={q}`,
      "query-input": "required name=q",
    },
  }}
>
  <div slot="sidebar-after" class="sidebar-home-tools">
    <input class="search-input" type="search" placeholder="搜索全文（标题 / 摘要 / 正文）" aria-label="搜索文章" data-post-search />
    <nav class="tag-nav sidebar-tag-nav" aria-label="标签筛选">
      <a href="/index.html" class="tag top active" data-tag="" aria-current="page">全部</a>
      <div class="tags-list collapsed" data-tag-list>
        {tags.map(([tag, count], index) => (
          <a
            href={`/index.html?tag=${encodeURIComponent(tag)}`}
            class:list={["tag", { visible: index < 5 }]}
            data-tag={tag}
          >
            {tag} ({count})
          </a>
        ))}
      </div>
      {tags.length > 5 && (
        <button class="tag-toggle" type="button" aria-expanded="false" data-tag-toggle data-collapsed-label={`展开全部标签 (${tags.length})`}>
          {`展开全部标签 (${tags.length})`}
        </button>
      )}
    </nav>
  </div>

  <aside class="directory latest-note-panel" id="latest-note-preview">
    <div class="panel-head">
      <h2 class="dir-title">最近随想</h2>
      <a class="panel-more" href="/notes.html">全部随想 →</a>
    </div>
    {latestNote ? (
      <p class="latest-note-text">
        <time datetime={latestNote.date}>{latestNote.date}</time>
        {toPlainText(latestNote.body, 120)}
      </p>
    ) : <p class="latest-note-text">暂无随想</p>}
  </aside>

  <aside class="directory" id="posts">
    <h2 class="dir-title">文章目录</h2>
    <div class="dir-list" data-post-list data-views-api={statsApi}>
      {posts.map((post) => (
        <div class="dir-item">
          <a class="dir-item-title" href={`/${post.url}`} data-astro-prefetch>
            {post.title}
          </a>
          <p class="meta-facts dir-item-meta">
            <time datetime={post.date}>{post.date}</time>
            <span>{post.reading.wordCount.toLocaleString("zh-CN")} 字</span>
            <span>{post.reading.readingMinutes} 分钟</span>
            <span class="view-count" hidden><span data-post-list-view data-post-slug={`/${post.url}`}>—</span> 次阅读</span>
          </p>
        </div>
      ))}
    </div>
  </aside>
  <script>
    import "../scripts/home";
  </script>
</BaseLayout>
