---
import BaseLayout from "../layouts/BaseLayout.astro";
import NoteItem from "../components/NoteItem.astro";
import { getNotes } from "../lib/notes";
import "../styles/content.css";
import "../styles/notes.css";

const notes = await getNotes();
---

<BaseLayout
  title="每天随想"
  description="一些零散的想法，随手记下。"
  canonicalPath="/notes.html"
  skipHref="#notes-main"
  skipText="跳转到随想"
  sidebarProps={{
    extraLinks: [{ href: "/index.html", label: "首页" }],
  }}
>
  <aside class="directory" id="notes-main">
    <div class="panel-head">
      <h2 class="dir-title">每天随想</h2>
      <span class="panel-more">{notes.length} 条</span>
    </div>
    <div class="notes-timeline">
      {notes.map((note) => <NoteItem note={note} />)}
    </div>
  </aside>
  <script>
    // Highlight the note a #link points at. A class instead of :target,
    // because client-side page navigation does not update :target.
    function highlightNote() {
      const id = decodeURIComponent(location.hash.slice(1));
      const note = id ? document.getElementById(id) : null;
      if (!note?.classList.contains("note-item")) return;
      note.classList.remove("is-target");
      void note.offsetWidth;
      note.classList.add("is-target");
    }
    document.addEventListener("astro:page-load", highlightNote);
    window.addEventListener("hashchange", highlightNote);
  </script>
</BaseLayout>
