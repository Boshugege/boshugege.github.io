# pnc-reactions settings. Copy to /home/lyy/services/pnc-reactions/.env (chmod 600)
# and fill in the two secrets. Every other line shows the built-in default.

# Address to listen on: loopback only, Caddy proxies /api/reactions* here.
HOST=127.0.0.1
# Port (register it in ~/services.yaml before starting the unit).
PORT=46220
# SQLite file (WAL mode); its directory must be writable (ReadWritePaths in the unit).
DB_PATH=/home/lyy/services/pnc-reactions/data/reactions.db
# Challenges and writes are accepted only from pages of this origin.
SITE_ORIGIN=https://parityncsvt.top
# Posts of the release being served; a /posts/<slug>.html target must be listed here.
BLOG_INDEX_FILE=/home/lyy/services/pnc-blog/current/index.json
# Notes of the release being served; a note:<id> target must be listed here.
NOTES_INDEX_FILE=/home/lyy/services/pnc-blog/current/notes.json
# How often (ms) the index files are stat()ed for a new release.
INDEX_CHECK_MS=10000

# Required. HMAC key for challenges, at least 32 chars: openssl rand -hex 32
CHALLENGE_SECRET=
# Or read it from a file instead (used only when CHALLENGE_SECRET is empty).
# CHALLENGE_SECRET_FILE=/home/lyy/services/pnc-reactions/challenge-secret
# Required. HMAC salt for visitor hashes, at least 32 chars, unlike CHALLENGE_SECRET. Never change it: dedupe depends on it.
VISITOR_SALT=
# Or read it from a file instead (used only when VISITOR_SALT is empty).
# VISITOR_SALT_FILE=/home/lyy/services/pnc-reactions/visitor-salt

# Leading zero bits the browser must find (14 is about 40 ms on a fast laptop).
POW_DIFFICULTY=14
# How long (ms) a challenge stays valid.
CHALLENGE_TTL_MS=60000

# Per visitor (IPv4 address or IPv6 /64): count reads per minute.
RATE_GET_PER_MINUTE=120
# Per visitor: challenges per minute.
RATE_CHALLENGE_PER_MINUTE=20
# Per visitor: reaction posts per minute.
RATE_POST_PER_MINUTE=10
# Per visitor: reaction posts per hour.
RATE_POST_PER_HOUR=60

# More than this many new reactions on one target within BURST_WINDOW_MS pauses that target.
BURST_TARGET_LIMIT=30
# More than this many new reactions site-wide within BURST_WINDOW_MS pauses every target.
BURST_GLOBAL_LIMIT=200
# Burst window (ms).
BURST_WINDOW_MS=600000
# How long (ms) a paused target (or the whole site) refuses new reactions.
BREAKER_COOLDOWN_MS=900000

# Optional: the existing alert bot, one message per breaker opening. Empty = no alerts.
TELEGRAM_BOT_TOKEN=
# Or read the token from a file (used only when TELEGRAM_BOT_TOKEN is empty).
# TELEGRAM_BOT_TOKEN_FILE=
# Chat that receives the alert.
TELEGRAM_CHAT_ID=
# Or read the chat id from a file (used only when TELEGRAM_CHAT_ID is empty).
# TELEGRAM_CHAT_ID_FILE=
