# pnc-bot configuration: copy to ~/.config/pnc-bot/config.env (chmod 600).
# No secrets live here: the bot token is read from PNC_BOT_TOKEN_FILE.
# Values below are the defaults except PNC_BOT_ALLOWED_USER_ID, which is required.

# REQUIRED: the only Telegram user the bot answers (your numeric user id;
# private chat only). Left empty on purpose: the bot refuses to start until
# it is set, and it also refuses the old example id 123456789.
PNC_BOT_ALLOWED_USER_ID=

# File holding the bot token (shared with Alertmanager and the daily report; 0600).
PNC_BOT_TOKEN_FILE=/home/lyy/observability/secrets/telegram_bot_token

# Telegram is only reachable through a proxy. Default: NaiveProxy's SOCKS5
# listener (naive@main). mihomo's HTTP port (http://127.0.0.1:7890) also works,
# but stalled about one tunnel in ten for 20+ seconds (SERVER.md 10.6).
PNC_BOT_PROXY=socks5h://127.0.0.1:10801

# The bot's own git clone (push access through its deploy key).
PNC_BOT_REPO=/home/lyy/services/pnc-bot/repo

# SQLite state (offsets, note/message mapping) and the git lock file.
PNC_BOT_STATE_DIR=/home/lyy/.local/state/pnc-bot

# Blog deploy root: current, releases/, logs/, state/deploys.jsonl.
PNC_BOT_BLOG_ROOT=/home/lyy/services/pnc-blog

# pnc-api's SQLite database (read-only, except hiding comments).
PNC_BOT_COMMENTS_DB=/home/lyy/services/pnc-api/data/pnc.db

# Public site (links in replies) and the local Caddy listener (checks).
PNC_BOT_SITE_URL=https://parityncsvt.top
PNC_BOT_LOCAL_SITE=http://127.0.0.1:46213

# Alertmanager API for /status.
PNC_BOT_ALERTMANAGER=http://127.0.0.1:19093
